                    <Canvas Width="200" Height="200" Panel.ZIndex="45">
                        <Image x:Name="NeedleOil" Source="/bmp_2_panel;component/assets/sensors/needle.png" 
                               Width="62" Height="62" Canvas.Left="69" Canvas.Top="45" 
                               Panel.ZIndex="45" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.98">
                            <Image.RenderTransform><RotateTransform Angle="-35"/></Image.RenderTransform>
                        </Image>
                        <Ellipse Width="22" Height="22" Fill="#151719" Stroke="#2A2D30" StrokeThickness="1" 
                                 Canvas.Left="89" Canvas.Top="96" Panel.ZIndex="46" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>

                <!-- Смазка КПП -->
                <Grid Canvas.Left="1665" Canvas.Top="705" Width="200" Height="200" Panel.ZIndex="30" Cursor="Hand" Tag="Lubricant" MouseLeftButtonDown="Sensor_MouseDown">
                    <Image x:Name="SensorLubricant" Source="/bmp_2_panel;component/assets/sensors/lubricant.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="/bmp_2_panel;component/assets/background/screw_round.png" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,22,0,0" Panel.ZIndex="50" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,22,0" Panel.ZIndex="50" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,22" Panel.ZIndex="50" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="/bmp_2_panel;component/assets/background/screw_round.png" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Panel.ZIndex="50" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="SensorLubricantBright" Source="/bmp_2_panel;component/assets/sensors/lubricant_bright.png" Style="{StaticResource SensorBrightOverlay}"/>
                    
                    <Canvas Width="200" Height="200" Panel.ZIndex="45">
                        <Image x:Name="NeedleLubricant" Source="/bmp_2_panel;component/assets/sensors/needle.png" 
                               Width="62" Height="62" Canvas.Left="69" Canvas.Top="45" 
                               Panel.ZIndex="45" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.98">
                            <Image.RenderTransform><RotateTransform Angle="-40"/></Image.RenderTransform>
                        </Image>
                        <Ellipse Width="22" Height="22" Fill="#151719" Stroke="#2A2D30" StrokeThickness="1" 
                                 Canvas.Left="89" Canvas.Top="96" Panel.ZIndex="46" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>

                <Button x:Name="BtnAbout" 
                        Style="{StaticResource MilitarySystemBtn}" 
                        Content="О ПРОГРАММЕ" 
                        Width="210" Height="52" 
                        Canvas.Left="1500" Canvas.Top="1005" 
                        Panel.ZIndex="50" 
                        Click="BtnAbout_Click"/>

                <Button x:Name="BtnExit" 
                        Style="{StaticResource MilitarySystemBtn}" 
                        Content="ВЫХОД" 
                        Width="150" Height="52" 
                        Canvas.Left="1730" Canvas.Top="1005" 
                        Panel.ZIndex="50" 
                        Click="BtnExit_Click"/>

                <local:InfoCard x:Name="TacticalInfoCard" 
                                Canvas.Left="0" Canvas.Top="0" 
                                Visibility="Collapsed" 
                                Panel.ZIndex="150"/>
                
            </Canvas>
            
            <Border x:Name="TopHud" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" 
                    Background="#E6181A1C" BorderBrush="#3A4045" BorderThickness="2" CornerRadius="6" 
                    Visibility="Collapsed" Panel.ZIndex="100">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="4" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" Margin="20,10">
                    <TextBlock Text="РЕЖИМ:" Foreground="#778088" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtCurrentMode" Text="ОЗНАКОМЛЕНИЕ" Foreground="#40C057" FontWeight="Bold" FontSize="16" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,30,0"/>
                    <Button Content="СМЕНИТЬ РЕЖИМ" Style="{StaticResource MilitarySystemBtn}" Width="150" Height="34" FontSize="13" Click="BtnShowMenu_Click"/>
                </StackPanel>
            </Border>
            
            <Grid x:Name="MainMenuOverlay" Background="#D9000000" Panel.ZIndex="200">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1C1E20" BorderBrush="#4E555B" BorderThickness="2" CornerRadius="8" Width="550">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.9"/>
                    </Border.Effect>
                    <Grid>
                        <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Margin="40,35,40,35">
                            <TextBlock Text="ТРЕНАЖЕР БМП-2" FontSize="24" FontWeight="Bold" Foreground="#E2E6EA" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="ВЫБЕРИТЕ СЦЕНАРИЙ ПОДГОТОВКИ" FontSize="13" FontWeight="SemiBold" Foreground="#778088" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                            
                            <Button Content="СВОБОДНОЕ ОЗНАКОМЛЕНИЕ" Style="{StaticResource MilitarySystemBtn}" Height="55" Margin="0,0,0,15" Tag="Free" Click="BtnModeSelect_Click"/>
                            <Button Content="ШТАТНЫЙ ПУСК ДВИГАТЕЛЯ" Style="{StaticResource MilitarySystemBtn}" Height="55" Margin="0,0,0,15" Tag="Normal" Click="BtnModeSelect_Click"/>
                            <Button Content="ПУСК ДВИГАТЕЛЯ С ПОДКАЧКОЙ" Style="{StaticResource MilitarySystemBtn}" Height="55" Margin="0,0,0,15" Tag="Pump" Click="BtnModeSelect_Click"/>
                            <Button Content="ЗИМНИЙ ПУСК С ПОДОГРЕВОМ" Style="{StaticResource MilitarySystemBtn}" Height="55" Margin="0,0,0,30" Tag="Winter" Click="BtnModeSelect_Click"/>

                            <Border Height="1" Background="#383D42" Margin="0,0,0,25"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="О ПРОГРАММЕ" Style="{StaticResource MilitarySystemBtn}" Height="45" FontSize="14" Click="BtnAbout_Click"/>
                                <Button Grid.Column="2" Content="ВЫХОД" Style="{StaticResource MilitarySystemBtn}" Height="45" FontSize="14" Click="BtnExit_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Оверлей предохранителя: увеличенный размер и шрифты -->
            <Grid x:Name="FuseInfoOverlay" Background="#D9000000" Panel.ZIndex="200" Visibility="Collapsed">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1C1E20" BorderBrush="#4E555B" BorderThickness="2" CornerRadius="8" Width="800">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.9"/>
                    </Border.Effect>
                    <Grid>
                        <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,15,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15,0,0,15" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15" RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Margin="50,45,50,45">
                            <TextBlock Text="ПРЕДОХРАНИТЕЛЬ (АЗС)" FontSize="32" FontWeight="Bold" Foreground="#E2E6EA" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="ВНУТРЕННЕЕ УСТРОЙСТВО" FontSize="18" FontWeight="SemiBold" Foreground="#778088" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                            
                            <Border Background="#111" BorderBrush="#383D42" BorderThickness="1" CornerRadius="4" Margin="0,0,0,25" Padding="20">
                                <Image Source="/bmp_2_panel;component/assets/fuse/fuse.png" Height="280" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            
                            <TextBlock Text="Стеклянный предохранитель с плавкой вставкой. Предназначен для защиты электрических цепей БМП-2 от токов короткого замыкания и перегрузок. При превышении допустимой нагрузки нить перегорает, разрывая цепь. Устанавливается под откручивающейся крышкой на панели." 
                                       FontSize="18" Foreground="#A0AAB2" FontFamily="Segoe UI" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,35" LineHeight="24"/>

                            <Button Content="ЗАКРЫТЬ КРЫШКУ" Style="{StaticResource MilitarySystemBtn}" Height="55" Width="250" FontSize="16" Click="BtnCloseFuse_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            
        </Grid>
    </Viewbox>
</Window>