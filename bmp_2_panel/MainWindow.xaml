<Window x:Class="bmp_2_panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bmp_2_panel"
        mc:Ignorable="d"
        Title="Панель приборов БМП-2" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="SensorBrightOverlay" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Panel.ZIndex" Value="10"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Пульсирующая обводка целевого элемента -->
        <Style x:Key="TargetHighlightBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#40C057"/>
            <Setter Property="Background" Value="#2240C057"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Panel.ZIndex" Value="100"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.8" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MilitaryToggle2Pos" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border Background="Transparent" 
                                    Width="54" Height="100" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>

                            <Image Source="/bmp_2_panel;component/assets/background/screw.png" 
                                   Width="24" Height="24" 
                                   VerticalAlignment="Top" 
                                   Margin="0,-30,0,0" 
                                   IsHitTestVisible="False" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Image Source="/bmp_2_panel;component/assets/background/screw_round.png" 
                                   Width="24" Height="24" 
                                   VerticalAlignment="Bottom" 
                                   Margin="0,0,0,-30" 
                                   IsHitTestVisible="False" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Image x:Name="ImgDown" 
                                   Source="/bmp_2_panel;component/assets/buttons/switch_down.png" 
                                   Width="130" Height="130" 
                                   Stretch="Uniform" 
                                   IsHitTestVisible="False" 
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Visible"/>

                            <Image x:Name="ImgUp" 
                                   Source="/bmp_2_panel;component/assets/buttons/switch_up.png" 
                                   Width="130" Height="130" 
                                   Stretch="Uniform" 
                                   IsHitTestVisible="False" 
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ImgUp" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ImgDown" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

