<UserControl x:Class="bmp_2_panel.InfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320">

    <UserControl.Resources>
        <Style x:Key="MiniCloseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="2" Width="24" Height="24">
                            <TextBlock Text="✕" Foreground="#6A737C" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#802626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#521717"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#E61C1E20" BorderBrush="#4E555B" BorderThickness="2" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.85"/>
        </Border.Effect>
        <Grid>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,30,0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            
            <Button Style="{StaticResource MiniCloseBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Click="BtnClose_Click"/>

            <StackPanel Margin="18,14,18,18">
                <TextBlock x:Name="TxtTitle" Text="АМПЕРМЕТР В-1" FontSize="15" FontWeight="Bold" Foreground="#E2E6EA" FontFamily="Segoe UI" Margin="0,0,10,2"/>
                <TextBlock x:Name="TxtSubtitle" Text="Контрольно-измерительный прибор" FontSize="11" FontWeight="SemiBold" Foreground="#A2AAB2" FontFamily="Segoe UI"/>
                
                <Border Height="1" Background="#383D42" Margin="0,8,0,10"/>
                
                <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" FontSize="13" LineHeight="18" Foreground="#B0B8C0" FontFamily="Segoe UI">
                    Показывает силу зарядного или разрядного тока аккумуляторных батарей. При работающем двигателе стрелка должна находиться в плюсовой зоне.
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>