<UserControl x:Class="bmp_2_panel.InfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440">

    <UserControl.Resources>
        <Style x:Key="MiniCloseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="3" Width="28" Height="28">
                            <TextBlock Text="✕" Foreground="#85909B" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#44FFFFFF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#992626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#662020"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F2181A1C" BorderBrush="#50575E" BorderThickness="2" CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.9"/>
        </Border.Effect>
        <Grid>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            
            <Button Style="{StaticResource MiniCloseBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Click="BtnClose_Click"/>

            <StackPanel Margin="24,18,24,22">
                <TextBlock x:Name="TxtTitle" Text="АМПЕРМЕТР В-1" FontSize="18" FontWeight="Bold" Foreground="#E2E6EA" FontFamily="Segoe UI" Margin="0,0,30,3"/>
                <TextBlock x:Name="TxtSubtitle" Text="Контрольно-измерительный прибор" FontSize="13" FontWeight="SemiBold" Foreground="#40C057" FontFamily="Segoe UI"/>
                
                <Border Height="1" Background="#383D42" Margin="0,10,0,12"/>
                
                <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" FontSize="15" LineHeight="21" Foreground="#C5CDD5" FontFamily="Segoe UI">
                    Показывает силу зарядного или разрядного тока аккумуляторных батарей. При работающем двигателе стрелка должна находиться в плюсовой зоне.
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>