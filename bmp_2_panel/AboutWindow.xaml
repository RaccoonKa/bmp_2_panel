<Window x:Class="bmp_2_panel.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="720" Height="470"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ModalCloseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="#242729" BorderBrush="#4A5055" BorderThickness="1" CornerRadius="3" Width="32" Height="32">
                            <TextBlock Text="✕" Foreground="#8F969C" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#802626"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#C23838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#521717"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="#1C1E20" BorderBrush="#4E555B" BorderThickness="2" CornerRadius="6" MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.8"/>
        </Border.Effect>
        <Grid>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image Source="/bmp_2_panel;component/assets/background/screw.png" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

            <Button Style="{StaticResource ModalCloseBtn}" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="100" Click="CloseButton_Click"/>

            <StackPanel Margin="34,22,48,22">
                <TextBlock Text="ИНТЕРАКТИВНЫЙ ТРЕНАЖЕР БМП-2" FontSize="17" FontWeight="Bold" Foreground="#E2E6EA" FontFamily="Segoe UI"/>
                <TextBlock Text="СИСТЕМА КОНТРОЛЯ И ИНДИКАЦИИ ЩИТКА МЕХАНИКА-ВОДИТЕЛЯ" FontSize="11" FontWeight="SemiBold" Foreground="#778088" FontFamily="Segoe UI" Margin="0,3,0,0"/>

                <Border Height="1" Background="#383D42" Margin="0,14,0,16"/>

                <TextBlock TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Foreground="#B0B8C0" FontFamily="Segoe UI">
                    Программный комплекс предназначен для изучения расположения органов управления, световой сигнализации и контрольно-измерительных приборов боевой машины пехоты БМП-2. Программа воспроизводит двухпозиционные тумблеры, аварийные защитные колпачки, регуляторы подсветки и аналоговые шкалы датчиков в режиме реального времени.
                </TextBlock>

                <Border Height="1" Background="#383D42" Margin="0,22,0,14"/>

                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="Выполнил: Кравчук Светозар Кириллович" FontSize="13" FontWeight="SemiBold" Foreground="#D5DCE2" FontFamily="Segoe UI" TextAlignment="Right"/>
                    <TextBlock Text="Научный руководитель: Рак Евгений Николаевич" FontSize="13" FontWeight="SemiBold" Foreground="#959FA8" FontFamily="Segoe UI" TextAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>